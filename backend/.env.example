# Google Cloud
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_REGION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=

# Gemini — use API key (Gemini API) OR leave blank to use ADC (Vertex AI)
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Firestore
FIRESTORE_DATABASE=(default)

# Pub/Sub
PUBSUB_TOPIC=regulus-runs
PUBSUB_SUBSCRIPTION=regulus-runs-sub

# CORS
ALLOWED_ORIGIN=http://localhost:3000

# App
ENVIRONMENT=development
LOG_LEVEL=INFO
SIMULATION_COUNT=500
MAX_RESEARCH_LOOPS=3

# Set to "true" to use mock data (no GCP credentials needed)
USE_MOCK_RESEARCH=true
USE_MOCK_FIRESTORE=false
USE_MOCK_PUBSUB=false
